# ローカル開発用（scripts/dev.mjs が .env.local を読み込む）。Vercel では同名の環境変数を設定する。
# コピーして .env.local を作る:  cp .env.example .env.local

# Supabase（Project Settings → API）。設定するとログイン機能が有効になる。anon key は公開前提。
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Twelve Data（任意）。設定すると現在値の取得元として最優先で使う。
TWELVEDATA_API_KEY=

# 開発サーバーのポート（既定 3000）
# PORT=3000
